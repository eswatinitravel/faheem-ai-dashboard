# Jitni keys daalein ge, utni zyada free limit. Khali chhor dein to woh provider skip ho jaye ga.
# Keys sirf is file (.env.local) mein, kabhi chat ya GitHub par nahi.

# 1) Groq - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2) Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 3) OpenRouter (sirf :free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# 4) Ollama (laptop par, koi limit nahi) - https://ollama.com/download
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
